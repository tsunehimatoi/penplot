{
  "name": "penplot-desktop",
  "version": "0.3.0",
  "description": "Penplot desktop workbench (Electron + Python + MCP)",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.penplot.desktop",
    "productName": "Penplot",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../webui/dist",
        "to": "webui/dist"
      },
      {
        "from": "../configs",
        "to": "configs"
      },
      {
        "from": "../seed",
        "to": "seed"
      },
      {
        "from": "../fonts",
        "to": "fonts"
      },
      {
        "from": "../dist/penplot-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage"
    }
  }
}
